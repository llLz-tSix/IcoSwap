<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="IcoSwap.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:IcoSwap.App"
    Title="IcoSwap">

    <Grid x:Name="Root" AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop">
        <Grid.Resources>
            <CollectionViewSource x:Name="GroupsSource" IsSourceGrouped="True" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Заголовок окна -->
        <Grid x:Name="AppTitleBar" Height="40" Padding="14,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/IcoSwap.ico" Width="18" Height="18" />
                <TextBlock Text="IcoSwap" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Выбор пака -->
        <Border Grid.Row="1" Margin="20,4,20,12" Padding="20,16" CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE8B9;" FontSize="32" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Name="PackTitle" Text="Перетащите сюда папку или zip с иконками" Style="{StaticResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="PackSubtitle" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Поддерживаются .ico, .png, .svg, .icl/.dll и zip-архивы. Иконки сопоставятся с ярлыками, типами файлов, папками и дисками автоматически." />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="PickFolderButton" Click="PickFolder_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE838;" FontSize="16" />
                            <TextBlock Text="Выбрать папку" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="PickFileButton" Click="PickFile_Click" ToolTipService.ToolTip="zip-архив, .icl или .dll с иконками">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xF012;" FontSize="16" />
                            <TextBlock Text="Выбрать файл" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Вкладки -->
        <Grid Grid.Row="2" Margin="16,0,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <SelectorBar x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged">
                <SelectorBarItem x:Name="TabPreview" Text="Предпросмотр" IsSelected="True" Icon="View" />
                <SelectorBarItem x:Name="TabUnmatched" Text="Нераспознанные" Icon="Help" />
                <SelectorBarItem x:Name="TabApplied" Text="Применено" Icon="Accept" />
            </SelectorBar>
            <StackPanel x:Name="SelectAllPanel" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4" VerticalAlignment="Center">
                <HyperlinkButton Content="Отметить все" Click="SelectAll_Click" />
                <HyperlinkButton Content="Снять все" Click="SelectNone_Click" />
            </StackPanel>
        </Grid>

        <!-- Содержимое вкладок -->
        <Grid Grid.Row="3" Margin="20,8,20,0">
            <!-- Предпросмотр -->
            <Grid x:Name="PreviewPanel">
                <ListView x:Name="PreviewList" ItemsSource="{x:Bind GroupsSource.View, Mode=OneWay}" SelectionMode="None"
                          Padding="0,0,0,12">
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate x:DataType="local:MatchGroup">
                                    <TextBlock Text="{x:Bind Key}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListView.GroupStyle>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="4,2" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:MatchRow">
                            <Grid ColumnSpacing="12" Padding="8,6" CornerRadius="6"
                                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{x:Bind Enabled, Mode=TwoWay}" MinWidth="0" VerticalAlignment="Center"
                                          AutomationProperties.Name="{x:Bind Title}" />
                                <Image Grid.Column="1" Source="{x:Bind BeforeImage, Mode=OneWay}" Width="32" Height="32" ToolTipService.ToolTip="Сейчас" />
                                <FontIcon Grid.Column="2" Glyph="&#xE72A;" FontSize="14" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <Image Grid.Column="3" Source="{x:Bind AfterImage}" Width="32" Height="32" ToolTipService.ToolTip="Станет" />
                                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind Note}" Visibility="{x:Bind NoteVisibility}" Style="{StaticResource CaptionTextBlockStyle}"
                                               TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xEA18;" FontSize="14" Visibility="{x:Bind AdminVisibility}"
                                              ToolTipService.ToolTip="Нужны права администратора (появится запрос UAC)" />
                                    <TextBlock Text="{x:Bind IconInfo}" Style="{StaticResource CaptionTextBlockStyle}" MaxWidth="260"
                                               TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel x:Name="EmptyPreview" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                    <FontIcon Glyph="&#xE7C5;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="Выберите пак иконок, чтобы увидеть, что изменится" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>

            <!-- Нераспознанные -->
            <Grid x:Name="UnmatchedPanel" Visibility="Collapsed" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                           Text="Эти иконки не удалось сопоставить автоматически. Нажмите на иконку, чтобы назначить её вручную: ярлыку, системному значку, диску, папке или расширению (например, .log)." />
                <GridView x:Name="UnmatchedGrid" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Unmatched_ItemClick">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="local:UnmatchedRow">
                            <StackPanel Width="112" Padding="8" Spacing="6" ToolTipService.ToolTip="{x:Bind Source}">
                                <Image Source="{x:Bind Image}" Width="48" Height="48" />
                                <TextBlock Text="{x:Bind Name}" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </Grid>

            <!-- Применено -->
            <Grid x:Name="AppliedPanel" Visibility="Collapsed">
                <ListView x:Name="AppliedList" SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="4,2" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:AppliedRow">
                            <Grid ColumnSpacing="12" Padding="8,6" CornerRadius="6" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Image Source="{x:Bind AppliedImage}" Width="32" Height="32" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xEA18;" FontSize="14" Visibility="{x:Bind AdminVisibility}"
                                              ToolTipService.ToolTip="Нужны права администратора" />
                                    <Button Content="Откатить" Click="RestoreOne_Click" Tag="{x:Bind Record.TargetId}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel x:Name="EmptyApplied" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                    <FontIcon Glyph="&#xE73E;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="Пока ничего не изменено — все иконки системные" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Нижняя панель -->
        <Grid Grid.Row="4" Padding="20,12" ColumnSpacing="12" Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <ProgressRing x:Name="Busy" IsActive="False" Width="20" Height="20" />
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="560"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <SplitButton x:Name="RefreshButton" Click="Refresh_Click" ToolTipService.ToolTip="Обновить иконки в Проводнике">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="16" />
                        <TextBlock Text="Обновить" />
                    </StackPanel>
                    <SplitButton.Flyout>
                        <MenuFlyout Placement="TopEdgeAlignedRight">
                            <MenuFlyoutItem Text="Глубокая очистка кэша (перезапуск Проводника)" Click="DeepRefresh_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE777;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </SplitButton>
                <Button x:Name="RestoreAllButton" Click="RestoreAll_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7A7;" FontSize="16" />
                        <TextBlock Text="Откатить всё" />
                    </StackPanel>
                </Button>
                <Button x:Name="ApplyButton" Style="{StaticResource AccentButtonStyle}" Click="Apply_Click" IsEnabled="False" MinWidth="140">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE73E;" FontSize="16" />
                        <TextBlock x:Name="ApplyText" Text="Применить" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <InfoBar x:Name="Info" Grid.Row="3" IsOpen="False" VerticalAlignment="Bottom" Margin="20,0,20,12" IsClosable="True" />
    </Grid>
</Window>
